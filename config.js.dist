module.exports = {
  appName: 'musikcsv',
  port: 3000,

  // Push heartbeat to an Uptime Kuma push monitor. Off unless heartbeatUrl is
  // set: the monitor cannot reach this host, so the app pushes out on a timer
  // and Kuma alerts when the pushes stop.
  // heartbeatUrl: 'https://uptime.example.com/api/push/abc123',
  // heartbeatIntervalMs: 60000,

  connections: {
    // The default connection.
    default: {
      server: 'srvsql.example.com',
      // domain: null,
      user: 'user',
      password: 'password',
      // encrypt: true,
      database: 'db',
      trustServerCertificate: true
    },
    another_connection: {
      server: 'srvsql.example.com',
      // domain: null,
      user: 'admin',
      password: 'password',
      database: 'db'
    }
  },

  routes: {
    items: {
      // no connection specified. Uses 'default'.
      query: `
SELECT *
  FROM items
 WHERE 1=1
`
    },
    users: {
      connection: 'another_connection',
      query: `
SELECT *
  FROM users
 WHERE 1=1
`
    }
  }
}
